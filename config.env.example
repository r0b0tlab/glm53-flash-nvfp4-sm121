# Copy this file to config.env and fill in your own values:
#
#     cp config.env.example config.env && $EDITOR config.env
#
# config.env is intentionally NOT committed (it holds node- and fabric-specific values).
# container/build.sh runs a single-node build without it; the serve/*.sh and
# scripts/finalize_package.sh scripts require it (or the equivalent exported variables).
#
# Placeholder values below only; no real hosts, addresses or paths are published.

# --- nodes -----------------------------------------------------------------
# Uncomment and fill in for a real two-node run. Leave them commented for a
# single-node image build (build.sh then skips distribution).
# ssh targets of the two GB10 ranks: rank0 starts second and binds the API,
# rank1 is headless and must be reachable from the head over ssh.
#RANK0=rank0.example.lan
#RANK1=rank1.example.lan
# RoCE fabric addresses used for the TP=2 rendezvous and NCCL payload traffic
# (the half of the QSFP port that carries data; documentation range shown here).
#RANK0_FABRIC=192.0.2.1
#RANK1_FABRIC=192.0.2.2
# RoCE HCA device and Ethernet interface on each rank.
#RANK0_HCA=rocep1s0f0; RANK0_ETH=enp1s0f0np0
#RANK1_HCA=rocep1s0f0; RANK1_ETH=enp1s0f0np0
#NCCL_IB_GID_INDEX=3

# --- ports -----------------------------------------------------------------
MASTER_PORT=25000
API_PORT=8000

# --- model trees -----------------------------------------------------------
MODEL_REPO=nvidia/GLM-5.3-Flash-NVFP4
MODEL_DIR=$HOME/models/nvidia/GLM-5.3-Flash-NVFP4
DFLASH2_REPO=incoai/GLM-5.3-Flash-DFlash2
DFLASH2_DIR=$HOME/models/incoai/GLM-5.3-Flash-DFlash2
SPEC_MODEL_DIR=${SPEC_MODEL_DIR:-$HOME/models/incoai/GLM-5.3-Flash-DFlash2}
WORK=$HOME/glm53-flash-nvfp4

# --- serving ---------------------------------------------------------------
IMAGE=${IMAGE:-glm53-flash-vllm-sm121:overlay-v2}
SERVED=glm-5.3-flash-nvfp4-sm121
